# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=0
LOGS_CHAT_ID=0
CANCELLATION_IMAGE_FILE_ID=
ADMINS=[0]
REMINDER_NOTIFY_USERNAME=username
TELEGRAM_PROXY_SCHEME=socks5
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Database
DB_PATH=database/bot.db

# Redis
REDIS_URL=redis://redis:6379/0

# Background jobs
TENANT_ACCESS_SYNC_ENABLED=true
TENANT_ACCESS_SYNC_INTERVAL_SECONDS=3600

# Monitoring
GRAFANA_PASSWORD=change-this-password

# JWT Authentication
JWT_SECRET=super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=1209600
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
BROWSER_REFRESH_COOKIE_NAME=tutorbase_refresh_token
BROWSER_REFRESH_COOKIE_SECURE=true
BROWSER_REFRESH_COOKIE_SAMESITE=lax

# CORS Origins (production example)
# For local development: '["http://localhost:5173","http://127.0.0.1:5173"]'
# For production: '["https://app.tutorbase.su","https://tutorbase.su"]'
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Mini App URL
# For local: http://localhost:5173
# For production: https://app.tutorbase.su/
MINI_APP_URL=http://localhost:5173
