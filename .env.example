BOT_TOKEN=your_token
# Для локального запуска используйте относительный путь внутри репозитория
DB_PATH=database/bot.db
GOOGLE_FORM_URL=https://forms.gle/...
ADMINS=[987654321,123456789]
ADMIN_CHAT_ID=-1234567890
LOGS_CHAT_ID=-0987654321
# Redis по умолчанию в docker-compose — можете переопределить на локальный
REDIS_URL=redis://localhost:6379/0
REGULATIONS_URL=https://notion.so/...
# Кого пинговать в логах напоминаний, оставьте по умолчанию или задайте username без @
REMINDER_NOTIFY_USERNAME=teacher_username

