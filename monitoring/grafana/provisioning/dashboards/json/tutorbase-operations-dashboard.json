{
  "uid": "tutorbase-operations",
  "title": "TutorBase Operations Monitoring",
  "tags": ["fastapi", "celery", "tutorbase", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 2,
  "refresh": "15s",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "type": "graph",
      "title": "HTTP Request Rate by Status",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{handler!~\"/metrics|/health\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Requests/sec"},
        {"format": "short"}
      ]
    },
    {
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "type": "graph",
      "title": "Top Endpoints by Request Rate",
      "targets": [
        {
          "expr": "topk(10, sum by (method, handler) (rate(http_requests_total{handler!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Requests/sec"},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "type": "stat",
      "title": "Active Packages",
      "targets": [
        {
          "expr": "active_packages"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8},
      "type": "stat",
      "title": "Scheduled Lessons",
      "targets": [
        {
          "expr": "scheduled_lessons"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8},
      "type": "stat",
      "title": "Total Learners",
      "targets": [
        {
          "expr": "total_learners"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8},
      "type": "stat",
      "title": "Unmatched Requests (1h)",
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{handler=\"none\"}[1h]))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "type": "graph",
      "title": "Slowest Endpoints (p95)",
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, handler) (rate(http_request_duration_seconds_bucket{handler!~\"/metrics|/health\"}[5m]))))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Duration"},
        {"format": "short"}
      ]
    },
    {
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "type": "graph",
      "title": "Slowest Endpoints (avg)",
      "targets": [
        {
          "expr": "topk(10, (sum by (method, handler) (rate(http_request_duration_seconds_sum{handler!~\"/metrics|/health\"}[5m]))) / clamp_min(sum by (method, handler) (rate(http_request_duration_seconds_count{handler!~\"/metrics|/health\"}[5m])), 0.001))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Duration"},
        {"format": "short"}
      ]
    },
    {
      "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "type": "graph",
      "title": "Junk Requests by Status (1h)",
      "targets": [
        {
          "expr": "sum by (status) (increase(http_requests_total{handler=\"none\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Requests"},
        {"format": "short"}
      ]
    },
    {
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "type": "graph",
      "title": "Client Errors (4xx) by Endpoint",
      "targets": [
        {
          "expr": "topk(10, sum by (status, method, handler) (rate(http_requests_total{status=~\"4..\", handler!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{status}} {{method}} {{handler}}"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Requests/sec"},
        {"format": "short"}
      ]
    },
    {
      "id": 11,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "type": "graph",
      "title": "Notification Deliveries (1h)",
      "targets": [
        {
          "expr": "increase(notification_deliveries_claimed_total[1h])",
          "legendFormat": "claimed"
        },
        {
          "expr": "sum by (result) (increase(notification_deliveries_processed_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Notifications"},
        {"format": "short"}
      ]
    },
    {
      "id": 12,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "type": "graph",
      "title": "Payment Amounts (24h)",
      "targets": [
        {
          "expr": "sum by (currency) (increase(payments_recorded_amount_total[24h]))",
          "legendFormat": "recorded {{currency}}"
        },
        {
          "expr": "sum by (currency) (increase(payments_voided_amount_total[24h]))",
          "legendFormat": "voided {{currency}}"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Amount"},
        {"format": "short"}
      ]
    },
    {
      "id": 13,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38},
      "type": "graph",
      "title": "Server Errors (5xx) by Endpoint",
      "targets": [
        {
          "expr": "topk(10, sum by (status, method, handler) (rate(http_requests_total{status=~\"5..\", handler!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{status}} {{method}} {{handler}}"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Requests/sec"},
        {"format": "short"}
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {}
}
